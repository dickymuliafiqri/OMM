# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
BOT_ADMIN_IDS="11223344,55667788"

# Turso LibSQL Database Configuration
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Benchmark Engine & Worker Pool
MAX_CONCURRENT_WORKERS=3
MAX_QUEUE_SIZE=20
PER_USER_HOURLY_LIMIT=5
BENCHMARK_TIMEOUT_SECONDS=300
SWE_STAGE_TIMEOUT_MINUTES=5

# Security & Sandbox Guard
AST_STRICT_MODE=true
MAX_PAYLOAD_BODY_BYTES=10485760

# Observability & Health Check
LOG_LEVEL="info"
HEALTH_CHECK_PORT=8080

# Access Control (Optional Whitelist Mode)
WHITELIST_MODE=false
WHITELIST_USER_IDS="11223344,55667788"
